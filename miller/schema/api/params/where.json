{
  "$schema": "http://json-schema.org/draft-07/schema",

  "oneOf": [
    { "$ref": "#/$defs/filter" },
    { "$ref": "#/$defs/operator" }
  ],
  "$defs": {
    "filter": {
      "type": "object",
      "properties": {
        "Op.or": { "$ref": "#/$defs/operator" },
        "Op.and": { "$ref": "#/$defs/operator" },
        "Op.not": {
          "oneOf": [
            {"$ref": "#/$defs/operator" },
            {"$ref": "#/$defs/lookup" }
          ]
        }
      },
      "additionalProperties": false
    },
    "lookup": {
       "type": "object",
       "propertyNames": {
         "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
       },
       "patternProperties": {
    	"^[A-Za-z_]":{
          "oneOf": [
            { "type": "string" },
            { "$ref": "#/$defs/values" }
          ]
        }
       }
    },
    "operator": {
      "type": "array",
      "items": {
        "anyOf": [
          {"$ref": "#"},
          {"$ref": "#/$defs/lookup"}
        ]
      },
      "minItems": 1,
      "maxItems": 10
    },
    "value": {
      "anyOf": [
        {"type": "number"},
        {"type": "boolean"},
        {
          "type": "string",
          "maxLength": 100
        }
      ]
    },
    "values": {
      "type": "array",
      "items": {
         "$ref": "#/$defs/value"
      }
    }
  }
}
